# ============================================================
# Пример файла .env для ЛОКАЛЬНОГО запуска (не для продакшена).
# На Railway переменные задаются в панели: Variables.
# Скопируйте в .env и подставьте свои значения.
# ============================================================

# --- Telegram (ОБЯЗАТЕЛЬНО) ---------------------------------
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=1234567890:AAF...your...token
# ID вашего чата с ботом (узнать у @userinfobot). Можно несколько через запятую.
CHAT_ID=123456789

# --- Режим выдачи сигналов -----------------------------------
# on_demand (default) — бот НИЧЕГО не присылает сам, только отвечает
#   на команды: /top, /signal, /coin, /coins, /funding, /calc...
#   Никакого спама: спросил — получил.
# auto — бот сам присылает сигнал, когда чистый спред >= порога
#   (с кулдауном на пару и лимитом сообщений за цикл).
SIGNAL_MODE=on_demand
# Одно приветственное сообщение при старте (true/false, default: true)
STARTUP_MESSAGE=true

# --- Фильтр сигналов (опционально, есть дефолты) -------------
# Минимальный ЧИСТЫЙ спред (после комиссий), % (default: 2.0)
MIN_SPREAD_PERCENT=2.0
# Антиспам: мин. пауза между сигналами по одной паре, мин (default: 15)
COOLDOWN_MINUTES=15
# Комиссии taker, % (default: 0.1 / 0.05)
SPOT_TAKER_FEE_PERCENT=0.1
FUTURES_TAKER_FEE_PERCENT=0.05
# Фильтр ликвидности: мин. объём на лучшей цене, USDT (default: 0 = выключен)
MIN_NOTIONAL_USD=0
# Максимум сообщений за один цикл сканирования (default: 5) — только для auto
MAX_SIGNALS_PER_SCAN=5
# Разрешить связки «спот+фьючерс на ОДНОЙ бирже» (default: false)
ALLOW_SAME_EXCHANGE=false

# --- Инструменты (опционально) -------------------------------
# Явный список пар через запятую (пусто = авто)
# SYMBOLS=BTC,ETH,SOL,XRP,DOGE
# Сколько пар отслеживать: 0 = ВСЕ поддерживаемые монеты на биржах
# (спот на >=1 бирже + перп на >=1 бирже, тысячи пар);
# N > 0 = только топ-N по объёму торгов (default: 0 — все монеты)
# TOP_SYMBOLS=0
# Авто-подбор (используется только при TOP_SYMBOLS > 0) (default: true)
# AUTO_DISCOVER_SYMBOLS=true

# --- Биржи и сбор данных (опционально) -----------------------
# Подмножество: mexc,bybit,gate,okx,binance (default: все)
# EXCHANGES=mexc,bybit,gate,okx,binance
# Использовать WebSocket ccxt.pro (default: true)
# USE_WEBSOCKET=true
# Глубина стакана: уровни в REST-запросах и WS-подписках (default: 5)
# ORDER_BOOK_DEPTH=5
# Пауза между кругами REST-опроса, сек (default: 3)
# REST_POLL_INTERVAL_SECONDS=3
# Доп. пауза между REST-запросами, сек (default: 0.05)
# REST_THROTTLE_SECONDS=0.05
# Базовый макс. возраст котировки в WS-режиме, сек (default: 45;
# в REST-режиме при больших списках расширяется автоматически)
# BOOK_MAX_AGE_SECONDS=45

# --- Funding-рейты (показ в /funding, /coin, /signal) --------
# Показывать funding (default: true)
# FUNDING_ENABLED=true
# Кэш funding-рейтов, мин (default: 10)
# FUNDING_CACHE_MINUTES=10
# Кэш объёмов 24ч для /coins, мин (default: 30)
# VOLUME_CACHE_MINUTES=30

# --- Служебное (опционально) ---------------------------------
# Период цикла оценки спредов, сек (default: 5)
# SCAN_INTERVAL_SECONDS=5
# Heartbeat-сообщение в Telegram раз в N минут (default: 0 = выключено)
# HEARTBEAT_MINUTES=0
# Уровень логирования: DEBUG / INFO / WARNING (default: INFO)
# LOG_LEVEL=INFO
