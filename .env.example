# Файл подхватывается автоматически при старте бота (ищется .env.local, затем .env
# в текущей директории и выше, затем рядом с корнем проекта).
# Реальные переменные окружения всегда важнее значений из этого файла.
# Путь можно задать явно: ENV_FILE=/путь/к/.env

# ── Telegram (обязательно) ────────────────────────────────
# Токен от @BotFather, формат 123456789:AAHdqTcv... — без кавычек и пробелов.
TELEGRAM_TOKEN=

# ── Доступ ────────────────────────────────────────────────
# Если заданы только ADMIN_CHAT_IDS — бот отвечает только им.
# Если заданы и ALLOWED_CHAT_IDS — бот отвечает им и админам.
ADMIN_CHAT_IDS=
ALLOWED_CHAT_IDS=

# ── Режим ─────────────────────────────────────────────────
DRY_RUN=true

# ── Биржи ─────────────────────────────────────────────────
EXCHANGES=binance,bybit
QUOTE_CURRENCIES=USDT
TOP_N_SYMBOLS=100

# ── Таймфреймы ────────────────────────────────────────────
BASE_TIMEFRAME=1h
ANALYSIS_TIMEFRAMES=1h,4h,1d
CANDLES_LIMIT=300

# ── Движок сигналов ───────────────────────────────────────
MIN_CONFIDENCE=75
MIN_VOLUME_USD_24H=5000000
MIN_ATR_PCT=0.3
MAX_ATR_PCT=12.0
ANTI_CHASE_WINDOW_BARS=12
ANTI_CHASE_MAX_PCT=8.0

# ── LLM (опционально) ────────────────────────────────────
LLM_ENABLED=false
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_MAX_TOKENS=220

# ── Хранилище/логи ───────────────────────────────────────
SIGNALS_DB=signals.db
DATA_DIR=data
LOG_LEVEL=INFO
