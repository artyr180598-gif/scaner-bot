# Required
TELEGRAM_BOT_TOKEN=replace_me
# One or more numeric Telegram chat/user IDs separated by commas.
TELEGRAM_CHAT_ID=123456789
# Existing deployments may keep CHAT_ID / ADMIN_CHAT_IDS / ALLOWED_CHAT_IDS.

# Market data source: bybit or binance. Public market endpoints do not require keys.
EXCHANGE=bybit
BYBIT_BASE_URL=https://api.bybit.com
BINANCE_BASE_URL=https://fapi.binance.com

# Scanner
SCAN_INTERVAL_SECONDS=900
RUN_SCAN_ON_STARTUP=true
STANDARD_AUTO_ALERTS_ENABLED=false
MAIN_SCAN_PREMOVE_ONLY=true
MAIN_SCAN_MIN_PREMOVE_READINESS=72
MAIN_SCAN_MIN_TRIGGER_DISTANCE_PCT=0.08
MAIN_SCAN_MAX_TRIGGER_DISTANCE_PCT=1.40
MAIN_SCAN_MAX_RECENT_MOVE_PCT=0.45
MAIN_SCAN_MAX_EXECUTION_RVOL=1.55
MIN_VOLUME_USDT=20000000
MAX_SPREAD_BPS=12
UNIVERSE_SIZE=80
SHORTLIST_SIZE=12
REQUEST_CONCURRENCY=8
TIMEFRAMES=15,60,240
MIN_AUTO_CONFIDENCE=88
MIN_AUTO_CONFIDENCE_SHORT=90
MIN_MANUAL_CONFIDENCE=72
ALERT_COOLDOWN_MINUTES=180
SIGNAL_EXPIRY_MINUTES=240
MAX_AUTO_SIGNALS_PER_SCAN=1
MAX_SAME_SIDE_AUTO_SIGNALS=1
MAX_PORTFOLIO_RISK_PCT=1.0
EXCLUDED_SYMBOLS=USDCUSDT,FDUSDUSDT,TUSDUSDT,USDEUSDT

# Adaptive market-regime filters
MIN_PRIMARY_ADX=18
MIN_EFFICIENCY_RATIO=0.14
MIN_EMA_GAP_ATR=0.08
MAX_COUNTERTREND_DMI=5
MAX_ATR_REGIME_RATIO=2.8
RELATIVE_STRENGTH_FILTER=true
NEUTRAL_REGIME_CONFIDENCE_PENALTY=2
MARKET_MICROSTRUCTURE_ENABLED=true

# Live paper validation and probability calibration
PAPER_TRACKING_ENABLED=true
PAPER_MAX_HOLDING_HOURS=72
PAPER_ONE_WAY_COST_BPS=6
CALIBRATION_MIN_SAMPLES=30
CALIBRATION_LOOKBACK=100
WEAK_EDGE_CONFIDENCE_PENALTY=2

# Early radar: arms before the 15m breakout; automatic alerts remain off by default.
EARLY_RADAR_ENABLED=true
EARLY_AUTO_ALERTS=false
EARLY_SHORTLIST_SIZE=10
MIN_EARLY_READINESS=68
MIN_EARLY_AUTO_READINESS=80
EARLY_ALERT_COOLDOWN_MINUTES=360
EARLY_SETUP_EXPIRY_MINUTES=720
EARLY_MIN_SQUEEZE_BARS=2
LIVE_WATCHLIST_INTERVAL_SECONDS=120

# Smart Money / pre-BOS realtime flow radar (Bybit websocket)
SMART_MONEY_AUTO_SCAN_ENABLED=true
SMART_MONEY_SCAN_INTERVAL_SECONDS=120
SMART_MONEY_INCLUDE_POST_BREAKOUT=false
FLOW_RADAR_ENABLED=true
FLOW_AUTO_ALERTS_ENABLED=false
FLOW_WATCHLIST_LIMIT=16
FLOW_MIN_NOTIONAL_60S=35000
FLOW_DELTA_RATIO_THRESHOLD=0.20
FLOW_VOLUME_BURST_RATIO=1.5
FLOW_MIN_OI_CHANGE_PCT_2M=0.12
FLOW_MIN_ALERT_SCORE=84
FLOW_EARLY_PRESSURE_ENABLED=true
FLOW_EARLY_PRESSURE_MIN_SCORE=82
FLOW_EARLY_PRESSURE_MAX_PRICE_MOVE_60S_PCT=0.10
FLOW_EARLY_PRESSURE_MIN_BURST_RATIO=1.05
FLOW_EARLY_PRESSURE_MAX_BURST_RATIO=1.45
FLOW_ALERT_COOLDOWN_MINUTES=360
FLOW_GLOBAL_COOLDOWN_MINUTES=180
FLOW_MAX_ALERTS_PER_DAY=2
FLOW_MAX_DIRECTIONAL_FUNDING_PCT=0.08
FLOW_VALIDATION_ENABLED=true
FLOW_VALIDATION_WINDOW_MINUTES=45
FLOW_VALIDATION_MIN_SAMPLES=20

# PRIME pre-move: very rare top candidate before obvious flow/price acceleration.
PRIME_ALERTS_ENABLED=true
PRIME_MIN_SCORE=88
PRIME_GLOBAL_COOLDOWN_MINUTES=180
PRIME_SYMBOL_COOLDOWN_MINUTES=720
PRIME_MAX_ALERTS_PER_DAY=3
PREPARE_ALERTS_ENABLED=true
PREPARE_MIN_SCORE=80
PREPARE_GLOBAL_COOLDOWN_MINUTES=60
PREPARE_SYMBOL_COOLDOWN_MINUTES=240
PREPARE_MAX_ALERTS_PER_DAY=4
PRIME_MIN_TRIGGER_DISTANCE_PCT=0.08
PRIME_MAX_TRIGGER_DISTANCE_PCT=1.20
PRIME_MAX_PRICE_MOVE_60S_PCT=0.12
PRIME_MAX_DIRECTIONAL_MOVE_15M_PCT=0.35
PRIME_SPOT_CONFIRMATION_ENABLED=true
PRIME_MIN_SPOT_TAKER_RATIO=0.60
PRIME_MIN_SPOT_BOOK_IMBALANCE=0.05
PRIME_MIN_SPOT_CONFIRMATIONS=2
PRIME_MAX_DIRECTIONAL_PERP_BASIS_BPS=20
PRIME_MIN_SPOT_BLOCK_NOTIONAL=50000
LIQUIDITY_INTELLIGENCE_ENABLED=true
LIQUIDITY_ORDERBOOK_WATCH_LIMIT=4
PRIME_MIN_PERSISTENT_WALL_RATIO=2.5
PRIME_MIN_WALL_PERSISTENCE_SECONDS=10
PRIME_MIN_REPLENISHMENT_NOTIONAL=25000
PRIME_MAX_DIRECTIONAL_LIQUIDATION_RATIO=0.25
PRIME_CROSS_EXCHANGE_ENABLED=true
PRIME_CROSS_EXCHANGE_REQUIRED=false
PRIME_CROSS_EXCHANGE_MIN_CONFIRMATIONS=2
PRIME_CROSS_EXCHANGE_MAX_PRICE_DIVERGENCE_BPS=35
PRIME_ENTRY_EXPIRY_MINUTES=90
PRIME_MIN_PLAN_RR=2.0
PRIME_MAX_STOP_PCT=2.5
PRIME_RISK_MULTIPLIER=0.5
PRIME_MAX_LEVERAGE=2
PRIME_SHADOW_ENABLED=true
PRIME_SHADOW_MIN_SCORE=74
PRIME_SHADOW_DEDUP_MINUTES=60
PRIME_SHADOW_MAX_HOLDING_HOURS=72
PRIME_SHADOW_MIN_SAMPLES=30

# Risk illustration shown in the signal. The bot never places orders.
ACCOUNT_EQUITY_USDT=1000
RISK_PER_TRADE_PCT=0.5
MAX_POSITION_PCT=25
MIN_RISK_REWARD=1.8
PREFERRED_LEVERAGE=2
MAX_LEVERAGE=3

# Runtime / Railway
DATA_DIR=./data
LOG_LEVEL=INFO
PORT=8080
HTTP_TIMEOUT_SECONDS=8
