# Файл .env подхватывается автоматически при старте (ищется .env.local, затем .env
# в текущей директории и выше, затем рядом с корнем проекта).
# Реальные переменные окружения всегда важнее значений из файла.

# ── Telegram (обязательно) ─────────────────────────────────────
# Токен от @BotFather, формат 123456789:AAHdqTcv... — без кавычек и пробелов.
# Принимаются также имена BOT_TOKEN, TELEGRAM_BOT_TOKEN, TG_TOKEN, BOT_API_TOKEN.
# Приоритет: TELEGRAM_TOKEN > BOT_TOKEN > TELEGRAM_BOT_TOKEN > TG_TOKEN > BOT_API_TOKEN.
TELEGRAM_TOKEN=

# ── Доступ ─────────────────────────────────────────────────────
ADMIN_CHAT_IDS=
ALLOWED_CHAT_IDS=

# ── Режим ──────────────────────────────────────────────────────
DRY_RUN=true

# ── Биржи и данные ─────────────────────────────────────────────
EXCHANGES=binance,bybit
QUOTE_CURRENCIES=USDT
TOP_N_SYMBOLS=100

# ── Таймфреймы ─────────────────────────────────────────────────
BASE_TIMEFRAME=1h
ANALYSIS_TIMEFRAMES=1h,4h,1d
CANDLES_LIMIT=300

# ── Движок сигналов ────────────────────────────────────────────
# Минимальный порог уверенности (для сбалансированного профиля).
MIN_CONFIDENCE=60
MIN_VOLUME_USD_24H=3000000
MIN_ATR_PCT=0.3
MAX_ATR_PCT=12.0
ANTI_CHASE_WINDOW_BARS=12
ANTI_CHASE_MAX_PCT=8.0
MAX_MATCHES=8

# ── LLM (опционально, для блока «почему») ──────────────────────
LLM_ENABLED=false
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_MAX_TOKENS=260

# ── Хранилище/логи ─────────────────────────────────────────────
SIGNALS_DB=signals.db
DATA_DIR=data
LOG_LEVEL=INFO
