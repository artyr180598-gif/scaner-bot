# CryptoForge Pro — environment variables
# Real Railway variables always override .env.
# Copy to .env for local development only (never commit .env).

# ── Telegram (обязательно) ─────────────────────
TELEGRAM_TOKEN=
BOT_USERNAME=
ADMIN_CHAT_IDS=
ALLOWED_CHAT_IDS=

# ── Биржи и данные ─────────────────────────────
EXCHANGES=binance,bybit
QUOTE_CURRENCIES=USDT
TOP_N_SYMBOLS=100
BASE_TIMEFRAME=1h
ANALYSIS_TIMEFRAMES=15m,1h,4h,1d
CANDLES_LIMIT=300

# ── Движок сигналов ────────────────────────────
MIN_CONFIDENCE=60
MIN_VOLUME_USD_24H=3000000
MIN_ATR_PCT=0.3
MAX_ATR_PCT=12.0
ANTI_CHASE_WINDOW_BARS=12
ANTI_CHASE_MAX_PCT=8.0
MAX_MATCHES=8
TOP_SCANS=3
CONFIDENCE_BUMP_FOR_OVERY_STRONG=3

# Профили риска: <имя>:<минимальная уверенность>
RISK_PROFILES=conservative:58,balanced:62,aggressive:67
DEFAULT_RISK_PROFILE=balanced

# ── Coinglass / новости (опционально) ──────────
COINGLASS_API_KEY=
COINGLASS_BASE_URL=https://open-api-v4.coinglass.com
CRYPTOPANIC_API_KEY=
NEWS_LANGUAGE=en

# ── Алерты / вотчер ─────────────────────────────
ALERT_CHECK_INTERVAL_SECONDS=60
ALERT_PRICE_WINDOW_PCT=1.5

# ── HTTP / кеш ─────────────────────────────────
HTTP_TIMEOUT=10
CACHE_TTL_SECONDS=45

# ── Хранилище / логи ───────────────────────────
SIGNALS_DB=data/signals.db
DATA_DIR=data
LOG_LEVEL=INFO
