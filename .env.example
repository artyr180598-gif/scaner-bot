# ============================================================
# Пример файла .env для ЛОКАЛЬНОГО запуска (не для продакшена).
# На Railway переменные задаются в панели: Variables.
# Скопируйте в .env и подставьте свои значения.
# ============================================================

# --- Telegram (ОБЯЗАТЕЛЬНО) ---------------------------------
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=1234567890:AAF...your...token
# ID вашего чата с ботом (узнать у @userinfobot). Можно несколько через запятую.
CHAT_ID=123456789

# --- Фильтр сигналов (опционально, есть дефолты) -------------
# Минимальный ЧИСТЫЙ спред (после комиссий), % (default: 2.0)
MIN_SPREAD_PERCENT=2.0
# Антиспам: мин. пауза между сигналами по одной паре, мин (default: 15)
COOLDOWN_MINUTES=15
# Комиссии taker, % (default: 0.1 / 0.05)
SPOT_TAKER_FEE_PERCENT=0.1
FUTURES_TAKER_FEE_PERCENT=0.05
# Фильтр ликвидности: мин. объём на лучшей цене, USDT (default: 0 = выключен)
MIN_NOTIONAL_USD=0
# Максимум сообщений за один цикл сканирования (default: 5)
MAX_SIGNALS_PER_SCAN=5
# Разрешить связки «спот+фьючерс на ОДНОЙ бирже» (default: false)
ALLOW_SAME_EXCHANGE=false

# --- Инструменты (опционально) -------------------------------
# Явный список пар через запятую (пусто = авто-подбор по объёму торгов)
# SYMBOLS=BTC,ETH,SOL,XRP,DOGE
# Авто-подбор топ-N пар по объёму (default: true / 30)
# AUTO_DISCOVER_SYMBOLS=true
# TOP_SYMBOLS=30

# --- Биржи и сбор данных (опционально) -----------------------
# Подмножество: mexc,bybit,gate,okx,binance (default: все)
# EXCHANGES=mexc,bybit,gate,okx,binance
# Использовать WebSocket ccxt.pro (default: true)
# USE_WEBSOCKET=true
# Глубина стакана для REST-запросов, уровней (default: 5)
# ORDER_BOOK_DEPTH=5
# Пауза между кругами REST-опроса, сек (default: 3)
# REST_POLL_INTERVAL_SECONDS=3
# Максимальный возраст котировки, сек (default: 45)
# BOOK_MAX_AGE_SECONDS=45

# --- Служебное (опционально) ---------------------------------
# Период цикла оценки спредов, сек (default: 5)
# SCAN_INTERVAL_SECONDS=5
# Heartbeat-сообщение в Telegram раз в N минут (default: 0 = выключено)
# HEARTBEAT_MINUTES=0
# Уровень логирования: DEBUG / INFO / WARNING (default: INFO)
# LOG_LEVEL=INFO
