# ============================================================
# Пример .env для крипто-советника (app/).
# Локально: скопируйте в .env и заполните. На Railway: панель Variables.
#
# Всё, что закомментировано, — необязательно: значения по умолчанию
# подобраны для продакшена (см. app/config/settings.py).
# Конфигурация проверяется на старте: ошибка в .env = понятное сообщение,
# а не падение в середине ночи.
# ============================================================

# --- Telegram (ОБЯЗАТЕЛЬНО) ---------------------------------
# Токен от @BotFather
TELEGRAM_BOT_TOKEN=1234567890:AAF...your...token

# Админы: могут менять общие настройки и видеть /health. ID узнать у @userinfobot.
ADMIN_CHAT_IDS=123456789
# Доступ к боту. Пусто = бот доступен всем (публичный бот).
# ALLOWED_CHAT_IDS=123456789,987654321
# TELEGRAM_PARSE_MODE=HTML

# --- Биржи ----------------------------------------------------
# Список ccxt-идентификаторов. Первый — основной источник тикеров.
EXCHANGES=binance,bybit,okx
# Где брать funding rate и open interest (нужен своп-рынок).
DERIVATIVES_EXCHANGES=binance,bybit
# Котирующая валюта и тип рынка для вселенной: spot | swap
QUOTE=USDT
MARKET_TYPE=spot
# REQUEST_TIMEOUT_MS=15000
# Сколько запросов к бирже можно держать параллельно (больше — чаще rate limit).
# RATE_LIMIT_CONCURRENCY=6
# Минимальная пауза между запросами, сек
# RATE_LIMIT_MIN_INTERVAL=0.06

# --- Вселенная монет ------------------------------------------
# Сколько пар анализируем (по обороту, сверху вниз).
MAX_UNIVERSE=250
# Ниже этого суточного оборота монету не смотрим: неликвид = манипуляции.
MIN_QUOTE_VOLUME_USD=3000000
# Стейблкоины и фиатные токены (добавлять сюда, если увидели мусор в списке).
# EXCLUDE_SYMBOLS=USDC,FDUSD,TUSD,DAI,BUSD,EUR,USDP
# Всегда включать в сканирование, даже если оборот маленький.
# INCLUDE_SYMBOLS=
# Отбрасывать плечевые токены (UP/DOWN/BULL/BEAR) — default true
# EXCLUDE_LEVERAGED_TOKENS=true

# --- Таймфреймы и данные --------------------------------------
# Базовый ТФ качается с биржи; старшие строятся ресемплингом из него,
# дневной — отдельным запросом (нужна длинная история для EMA200).
# ВАЖНО: ANALYSIS_TIMEFRAMES не должен содержать ТФ младше BASE_TIMEFRAME.
BASE_TIMEFRAME=1h
ANALYSIS_TIMEFRAMES=1h,4h,1d
# ТФ, на котором даются сигналы (должен входить в ANALYSIS_TIMEFRAMES).
SIGNAL_TIMEFRAME=1h
# Сколько свечей базового ТФ качать (~30 суток часовых).
BARS_BASE=720
# Сколько дневных свечей (год — для EMA200 и структуры старшего ТФ).
BARS_DAILY=360
# TTL кэша свечей, сек
# CACHE_TTL_SECONDS=60
# Свечи старше этого считаются протухшими: сигнал не публикуется.
# MAX_STALENESS_SECONDS=300
# Минимум свечей, чтобы вообще анализировать монету.
# MIN_BARS_REQUIRED=120

# --- Отбор кандидатов -----------------------------------------
# Сколько монет проходит грубый отбор и попадает на глубокий анализ.
# Меньше — быстрее скан и жёстче фильтр, больше — шире охват.
PRESCREEN_CANDIDATES=35
# Параллельных глубоких анализов
# DEEP_ANALYSIS_CONCURRENCY=6
# Насколько «сжатой пружиной» должна быть монета (перцентиль ATR), 0..100.
# MIN_COMPRESSION_PERCENTILE=55
# Анти-погоня: не берём монеты, чей рост — статистический выброс.
# MAX_RUN_ZSCORE=2.2
# Не берём стоящие вплотную к хаю без отката, %
# MAX_DISTANCE_HIGH_PCT=6.0
# Порог аномалии объёма (z-score)
# VOLUME_ANOMALY_Z=2.0

# --- Риск и пороги качества сигнала ----------------------------
# conservative | moderate | aggressive
# Задаёт сразу RISK_PER_TRADE_PCT, MAX_LEVERAGE, MIN_CONFIDENCE, MIN_RR.
# Значения ниже переопределяют пресет.
RISK_PROFILE=moderate
# Депозит — только для расчёта объёма позиции в карточке.
DEPOSIT_USD=1000
# RISK_PER_TRADE_PCT=1.0
# MAX_LEVERAGE=3.0
# Уверенность 0..10, ниже — сигнал не публикуется (moderate = 5.5).
# MIN_CONFIDENCE=5.5
# Минимальный средний R:R по трём целям (moderate = 1.6).
# MIN_RR=1.6
# Сколько сигналов храним в «топ» за один скан
# MAX_OPEN_SIGNALS=12
# |итоговый счёт| ниже этого — всегда WAIT, даже если монета интересная.
# WAIT_THRESHOLD=0.12
# Вход дальше N ATR от зоны = «погоня», сигнал не публикуется.
# ВАЖНО: на реальных данных жёсткое значение (1.5) себя НЕ оправдало,
# см. AI_AGENTS/BRAIN.md. Не занижайте без своего бектеста.
# ANTI_CHASE_ATR=2.0
# Требовать совпадения с рынковой структурой
# REQUIRE_STRUCTURE_ALIGNMENT=true

# --- Сканер и рассылка -----------------------------------------
# Период фонового сканирования, минут (минимум 5 — иначе rate limit).
SCAN_INTERVAL_MIN=30
# Присылать сильные сигналы без запроса
AUTO_PUSH=true
# Авто-пуш только при уверенности ≥ (выше порога публикации).
PUSH_MIN_CONFIDENCE=7.0
# Сколько сигналов показывать в «Топ»
TOP_N=8
# Кулдаун повторного сигнала по той же монете и направлению, минут.
# WATCHLIST_COOLDOWN_MIN=120
# Запустить сканирование сразу при старте бота
# STARTUP_SCAN=true

# --- Внешние источники (опционально) ---------------------------
# Новости/соцсигналы отключены по умолчанию: это самый шумный фактор.
# Включать только с ключом, и помнить, что вес новости в скоринге мал (0.40).
# NEWS_ENABLED=false
# CRYPTOCOMPARE_API_KEY=
# NEWS_MAX_ITEMS=12
# SOCIAL_ENABLED=false

# --- Служебное --------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Куда писать журнал сигналов и настройки чатов (на Railway — том /data).
DATA_DIR=data
# Не отправлять сообщения в Telegram (локальная отладка рендера).
DRY_RUN=false
