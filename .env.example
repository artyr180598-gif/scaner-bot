# ============================================================
# Пример файла .env для ЛОКАЛЬНОГО запуска (не для продакшена).
# На Railway переменные задаются в панели: Variables.
# Скопируйте в .env и подставьте свои значения.
# ============================================================

# --- Telegram (ОБЯЗАТЕЛЬНО) ---------------------------------
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=1234567890:AAF...your...token
# ID вашего чата с ботом (узнать у @userinfobot). Можно несколько через запятую.
CHAT_ID=123456789

# --- Режим выдачи сигналов -----------------------------------
# on_demand (default) — бот НИЧЕГО не присылает сам, только отвечает
#   на команды: /top, /signal, /coin, /coins, /funding, /calc...
#   Никакого спама: спросил — получил.
# auto — бот сам присылает сигнал, когда чистый спред >= порога
#   (с кулдауном на пару и лимитом сообщений за цикл).
SIGNAL_MODE=on_demand
# Одно приветственное сообщение при старте (true/false, default: true)
STARTUP_MESSAGE=true

# --- Квантовое ядро v3 (стратегия сигналов) -------------------
# adaptive (default) — двухклассовый движок, проверенный бектестом на 4.5
#   годах реальных данных (PF 3.33, winrate 71%, maxDD 1.29%):
#   CARRY     — сбор funding: держим спот+шорт перпа, пока платят (дни-недели);
#   REVERSION — вход на статистической аномалии спреда (z-score против
#               истории пары), выход на сходимости (часы-дни).
# fixed — легаси-режим v2 (плоский порог MIN_SPREAD_PERCENT; на ликвидных
#   парах почти не срабатывает — 68 сигналов за 4.5 года против 1269 у v3).
# STRATEGY_MODE=adaptive
# REVERSION: z-аномалия для входа, сигм (default: 1.5)
# Z_ENTRY=1.5
# REVERSION: мин. чистый профит ПОСЛЕ round-trip комиссий, % (default: 0.2)
# MIN_NET_REVERSION_PERCENT=0.2
# REVERSION: перцентиль спреда в истории пары, 0=выкл (default: 90)
# PCT_ENTRY=90
# CARRY: мин. вклад funding за горизонт, % (default: 0.3)
# MIN_FUNDING_EDGE_PERCENT=0.3
# CARRY: мин. ожидаемый итог (спред − round-trip + funding), % (default: 0.15)
# MIN_NET_ROUNDTRIP_PERCENT=0.15
# CARRY: z-пол — не лезем, если спред аномально вывернут против нас (default: -1)
# Z_ENTRY_MIN=-1
# CARRY: горизонт удержания для расчёта funding, ч (default: 240)
# FUNDING_HORIZON_HOURS=240
# Анти-мерцание: подтверждений подряд (сканов) (default: 3)
# MIN_PERSISTENCE=3
# Минимум наблюдений истории пары (сканов по 5 с → ~30 мин) (default: 360)
# MIN_HISTORY=360
# Окно памяти пары, секунд (default: 21600 = 6 ч)
# HISTORY_SECONDS=21600
# Авто-пуш только при confidence ≥ этого (0-100) (default: 65)
# CONFIDENCE_MIN_PUSH=65
# Выход из эпизода: z вернулся к среднему (default: 0)
# Z_EXIT=0
# Тайм-стоп эпизода, ч, 0=выкл (default: 240)
# MAX_EPISODE_HOURS=240
# Мин. исполнимая глубина обеих ног для сигнала, $ (default: 100)
# MIN_FILLABLE_USD=100

# --- Фильтр сигналов (опционально, есть дефолты) -------------
# Минимальный ЧИСТЫЙ спред (после комиссий), % (default: 2.0)
MIN_SPREAD_PERCENT=2.0
# Антиспам: мин. пауза между сигналами по одной паре, мин (default: 15)
COOLDOWN_MINUTES=15
# Комиссии taker, % (default: 0.1 / 0.05)
SPOT_TAKER_FEE_PERCENT=0.1
FUTURES_TAKER_FEE_PERCENT=0.05
# Фильтр ликвидности: мин. объём на лучшей цене, USDT (default: 0 = выключен)
MIN_NOTIONAL_USD=0
# Размер входа ($), на который проверяется ИСПОЛНИМОСТЬ спреда: бот набирает
# эту сумму по уровням стакана (VWAP) на обеих ногах и показывает реальный
# профит с учётом проскальзывания — либо максимум, на который хватает
# глубины («≤$X!» в /top). Ставь свой типичный размер входа. (default: 100)
# EVAL_NOTIONAL_USD=100
# Максимум сообщений за один цикл сканирования (default: 5) — только для auto
MAX_SIGNALS_PER_SCAN=5
# Разрешить связки «спот+фьючерс на ОДНОЙ бирже» (default: false)
ALLOW_SAME_EXCHANGE=false

# --- Анти-мусор: защита от фейковых «миллиардных» спредов ----
# Разные биржи листают РАЗНЫЕ монеты под одним тикером (CAT на OKX-споте —
# Simon's Cat за $0.000002, а «CAT» на чужом перпе — другой проект за $800).
# Фильтр: если цена биржи отклоняется от МЕДИАНЫ по всем биржам сильнее
# порога — это тикер-двойник/битый стакан, в связки он не идёт (default: 50)
PRICE_DEVIATION_MAX_PERCENT=15
# Потолок гросс-спреда: всё, что выше, — неисполнимый разрыв или мусор
# (реальные межбиржевые спреды почти всегда < единиц процентов). 0 = выкл.
MAX_SPREAD_PERCENT=8

# --- Инструменты (опционально) -------------------------------
# Явный список пар через запятую (пусто = авто)
# SYMBOLS=BTC,ETH,SOL,XRP,DOGE
# Сколько пар отслеживать: 0 = ВСЕ поддерживаемые монеты на биржах
# (спот на >=1 бирже + перп на >=1 бирже, тысячи пар);
# N > 0 = только топ-N по объёму торгов (default: 0 — все монеты)
# TOP_SYMBOLS=0
# Авто-подбор (используется только при TOP_SYMBOLS > 0) (default: true)
# AUTO_DISCOVER_SYMBOLS=true

# --- Биржи и сбор данных (опционально) -----------------------
# Подмножество: mexc,bybit,okx,binance (Gate.io убран)
# EXCHANGES=mexc,bybit,okx,binance
# Использовать WebSocket ccxt.pro (default: true)
# USE_WEBSOCKET=true
# Глубина стакана: уровни в REST-запросах и WS-подписках (default: 5)
# ORDER_BOOK_DEPTH=5
# Пауза между кругами REST-опроса, сек (default: 3)
# REST_POLL_INTERVAL_SECONDS=3
# Доп. пауза между REST-запросами, сек (default: 0.05)
# REST_THROTTLE_SECONDS=0.05
# Базовый макс. возраст котировки в WS-режиме, сек (default: 45;
# в REST-режиме при больших списках расширяется автоматически)
# BOOK_MAX_AGE_SECONDS=45

# --- Funding-рейты (показ в /funding, /coin, /signal) --------
# Показывать funding (default: true)
# FUNDING_ENABLED=true
# Кэш funding-рейтов, мин (default: 10)
# FUNDING_CACHE_MINUTES=10
# Кэш объёмов 24ч для /coins, мин (default: 30)
# VOLUME_CACHE_MINUTES=30

# --- Служебное (опционально) ---------------------------------
# Период цикла оценки спредов, сек (default: 5)
# SCAN_INTERVAL_SECONDS=5
# Heartbeat-сообщение в Telegram раз в N минут (default: 0 = выключено)
# HEARTBEAT_MINUTES=0
# Уровень логирования: DEBUG / INFO / WARNING (default: INFO)
# LOG_LEVEL=INFO
